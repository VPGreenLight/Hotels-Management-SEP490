# ==================== Project Configuration ====================
COMPOSE_PROJECT_NAME=hotel_management
TZ=Asia/Ho_Chi_Minh

# ==================== PostgreSQL Configuration ====================
POSTGRES_DB=hotel_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# ==================== KeyDB Configuration ====================
KEYDB_PASSWORD=your_secure_password_here
KEYDB_PORT=6379
KEYDB_MAXMEMORY=512mb

# ==================== pgAdmin Configuration ====================
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=your_secure_password_here
PGADMIN_PORT=5050

# ==================== RedisInsight Configuration ====================
REDIS_INSIGHT_PORT=5540
